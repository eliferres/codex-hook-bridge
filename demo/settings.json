{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 demo/hooks/no_publish.py"}]},
      {"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "python3 demo/hooks/protect_env.py"}]},
      {"matcher": "Grep", "hooks": [{"type": "command", "command": "python3 demo/hooks/search_log.py"}]},
      {"matcher": "Deploy", "hooks": [{"type": "command", "command": "python3 demo/hooks/deploy_window.py"}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "python3 demo/hooks/notify.py"}]}
    ]
  }
}
